# Add on the API / backend service only (not the web-only service).
# Files upload browser → S3 via presigned URLs; the API signs URLs and verifies objects.
#
# S3_ENDPOINT=https://s3.eu-north-1.amazonaws.com
# S3_BUCKET=kaneo-storage
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=eu-north-1
# S3_FORCE_PATH_STYLE=false
#
# Bucket CORS must allow your public web origin, e.g.:
#   AllowedMethods: GET, PUT, HEAD
#   AllowedOrigins: https://kaneoweb-production.up.railway.app
#   AllowedHeaders: *
#   ExposeHeaders: ETag
