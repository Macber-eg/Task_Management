# Add these on the Kaneo service (API process) in Railway → Variables.
# Required for workspace invitation emails, sign-in codes, and password reset.
# After saving, redeploy. Invitation links use KANEO_CLIENT_URL — keep it on your public https URL.
#
# Minimum required keys: SMTP_HOST + SMTP_FROM (+ auth if your provider requires it)

# --- Resend (https://resend.com) — SMTP relay ---
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASSWORD=<your Resend API key>
# SMTP_FROM=Kaneo <onboarding@your-verified-domain.com>

# --- Brevo / Sendinblue ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=<your Brevo login email>
# SMTP_PASSWORD=<your Brevo SMTP key>
# SMTP_FROM=Kaneo <noreply@your-domain.com>

# --- SendGrid ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=apikey
# SMTP_PASSWORD=<your SendGrid API key>
# SMTP_FROM=Kaneo <verified-sender@your-domain.com>

# --- Gmail (App Password; not recommended for production volume) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=<16-char app password>
# SMTP_FROM=Kaneo <you@gmail.com>

# Optional: public URL for logos in HTML emails (defaults to KANEO_CLIENT_URL/email)
# KANEO_EMAIL_ASSETS_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/email

# When SMTP is on, sign-in defaults to email OTP codes. Keep password sign-in instead:
# DISABLE_EMAIL_OTP_SIGN_IN=true
