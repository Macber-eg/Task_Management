# Copy these into the Kaneo service in Railway (Variables tab).
# Replace "Postgres" with your database service name if different.
#
# Required
KANEO_CLIENT_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
DATABASE_URL=${{Postgres.DATABASE_URL}}
AUTH_SECRET=<run: openssl rand -hex 32>
#
# Bundled image listens on 5173 (set under Networking → Public → Port)
PORT=5173
#
# Recommended after you create the first admin account
# DISABLE_REGISTRATION=true
# DISABLE_GUEST_ACCESS=true
