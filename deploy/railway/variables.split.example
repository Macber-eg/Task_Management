# Split API + web services (use api.railway.toml and web.railway.toml).
# Full guide: SPLIT_DEPLOY.md — SMTP on API only; S3 on API only; uploads go browser → S3.

# --- API service (deploy/railway/api.railway.toml) ---
AUTH_SECRET=<openssl rand -hex 32>
DATABASE_URL=${{Postgres.DATABASE_URL}}
KANEO_API_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
KANEO_CLIENT_URL=${{kaneo-web.KANEO_CLIENT_URL}}
CORS_ORIGINS=${{kaneo-web.KANEO_CLIENT_URL}}
# SMTP: deploy/railway/smtp.env.example
# S3: deploy/railway/s3.env.example

# --- Web service (deploy/railway/web.railway.toml, public port 5173) ---
KANEO_CLIENT_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
KANEO_API_URL=${{kaneo-api.KANEO_API_URL}}
PORT=5173
AUTH_SECRET=${{kaneo-api.AUTH_SECRET}}
