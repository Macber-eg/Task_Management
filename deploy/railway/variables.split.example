# Split API + web services (use api.railway.toml and web.railway.toml).
# Rename services in Railway to match references below, or adjust ${{...}} names.

# --- API service ---
AUTH_SECRET=<openssl rand -hex 32>
DATABASE_URL=${{Postgres.DATABASE_URL}}
KANEO_API_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
KANEO_CLIENT_URL=${{kaneo-web.KANEO_CLIENT_URL}}

# --- Web service (public port 5173) ---
KANEO_CLIENT_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
KANEO_API_URL=${{kaneo-api.KANEO_API_URL}}
