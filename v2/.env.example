# Kaneo v2 — environment for compose.yml (copy to .env and fill in).
# Every setting belongs to the backend; the web app only has the build-time
# VITE_API_URL (see compose.split.yml). Optional features stay off until their
# variables are set. Never commit the real .env.
#
# Most secrets also accept NAME_FILE pointing at a file (Docker/Kubernetes
# secrets): AUTH_SECRET_FILE, POSTGRES_PASSWORD_FILE,
# CUSTOM_OAUTH_CLIENT_SECRET_FILE.

# --- Compose ----------------------------------------------------------------
# Host port the web app (and, through it, the API) is published on.
KANEO_HTTP_PORT=8088
# Only with compose.split.yml: the API's own published port, and the public
# API URL baked into the web build (empty in the same-origin layout).
# KANEO_API_PORT=1337
# VITE_API_URL=https://api.example.com

# --- Core -------------------------------------------------------------------
# Public URL people open. Used for CORS, the WebSocket origin check, links in
# emails and OAuth redirects back to the app.
KANEO_CLIENT_URL=http://localhost:8088
# Public URL of the API. In the same-origin layout it is the app URL + /api.
# OAuth callback URLs are built from its origin: <origin>/api/auth/...
KANEO_API_URL=http://localhost:8088/api
# Comma-separated origins allowed to call the API with cookies.
# Defaults to KANEO_CLIENT_URL; only needed for extra origins.
# CORS_ORIGINS=
# Cookie Domain attribute, for an API and app on sibling subdomains
# (e.g. .example.com). Leave unset for the same-origin layout.
# COOKIE_DOMAIN=
# Required, at least 32 characters. Signs access tokens and verifies the
# previous backend's session cookies, so reuse the old AUTH_SECRET when
# migrating or every user is signed out. Generate: openssl rand -hex 32
AUTH_SECRET=
# Access token lifetime in seconds (default 300).
# AUTH_ACCESS_TTL_SECONDS=300
# Port the backend listens on inside its container (default 1337).
# PORT=1337
# Reverse proxies allowed to report the client address (X-Forwarded-For):
# comma-separated IPs or CIDR ranges, or "none". Default: loopback only.
# compose.yml trusts the private Docker network, where the frontend's nginx
# is the only way in.
# TRUSTED_PROXIES=127.0.0.0/8,::1/128

# --- Database ---------------------------------------------------------------
# compose.yml builds DATABASE_URL for the bundled postgres service from these.
POSTGRES_DB=kaneo
POSTGRES_USER=kaneo
# Required for the bundled postgres service.
POSTGRES_PASSWORD=
# To use an external database instead, set DATABASE_URL (it wins over the
# POSTGRES_* parts) and remove the postgres service:
# DATABASE_URL=postgresql://kaneo:password@db.example.com:5432/kaneo

# --- Realtime fan-out (optional) ---------------------------------------------
# Only needed with more than one backend instance. A single instance delivers
# events in memory. Cluster wins over Sentinel, which wins over REDIS_URL.
# REDIS_URL=redis://redis:6379
# REDIS_PASSWORD=
# REDIS_CLUSTER_NODES=redis-1:6379,redis-2:6379
# REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379
# REDIS_SENTINEL_MASTER_NAME=mymaster
# REDIS_SENTINEL_PASSWORD=
# REDIS_SENTINEL_TLS=false

# --- Registration and sign-in -------------------------------------------------
# DISABLE_REGISTRATION=false
# DISABLE_PASSWORD_REGISTRATION=false
# DISABLE_EMAIL_OTP_SIGN_IN=false
# DISABLE_LOGIN_FORM=false
# DISABLE_GUEST_ACCESS=false
# DISABLE_WORKSPACE_CREATION=false
# DEMO_MODE=false
# Cloudflare Turnstile captcha on sign-up and sign-in (both keys).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Client IDs allowed to use the CLI device sign-in, comma-separated.
# DEVICE_AUTH_CLIENT_IDS=

# --- Social and OIDC sign-in ---------------------------------------------------
# Register callback URLs as <KANEO_API_URL origin>/api/auth/callback/<github|google|discord>,
# and <KANEO_API_URL origin>/api/auth/oauth2/callback/custom for the generic provider.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# Legacy names, still read when the GITHUB_OAUTH_* pair is not set:
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Generic OpenID Connect / OAuth provider. Either a discovery URL, or the
# authorization, token and user-info URLs.
# CUSTOM_OAUTH_CLIENT_ID=
# CUSTOM_OAUTH_CLIENT_SECRET=
# CUSTOM_OAUTH_DISCOVERY_URL=
# CUSTOM_OAUTH_AUTHORIZATION_URL=
# CUSTOM_OAUTH_TOKEN_URL=
# CUSTOM_OAUTH_USER_INFO_URL=
# Comma-separated.
# CUSTOM_OAUTH_SCOPES=
# CUSTOM_OAUTH_RESPONSE_TYPE=code
# PKCE is on unless set to false.
# CUSTOM_AUTH_PKCE=true
# CUSTOM_OAUTH_AUTO_LOGIN=false
# CUSTOM_OAUTH_LOGOUT_URL=

# --- Email (SMTP) --------------------------------------------------------------
# Invitations, sign-in codes and notifications. SMTP_HOST and SMTP_FROM turn it on.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Kaneo <noreply@example.com>
# STARTTLS is required unless set to false (only for an unencrypted local relay,
# together with SMTP_SECURE=false). SMTP_IGNORE_TLS is no longer supported.
# SMTP_REQUIRE_TLS=true
# Where email images are loaded from (default <KANEO_CLIENT_URL>/email).
# KANEO_EMAIL_ASSETS_URL=

# --- File storage (S3-compatible) ----------------------------------------------
# Attachments, images and project backgrounds. S3_ENDPOINT and S3_BUCKET turn
# it on; leave both keys unset to use the AWS default credential chain.
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=
# S3_KEY_PREFIX=
# Largest accepted upload in bytes (default 10485760 = 10 MB).
# S3_MAX_IMAGE_UPLOAD_BYTES=10485760

# --- Integrations and MCP -------------------------------------------------------
# Encrypts secrets stored with notification channels; required to save one.
# Keep the previous backend's value so existing secrets still decrypt.
# NOTIFICATION_SECRET_ENCRYPTION_KEY=
# Allow outgoing webhooks to private network addresses (off by default).
# KANEO_ALLOW_PRIVATE_WEBHOOK_DESTINATIONS=false
# Trello importer: this server's Trello app key (users can bring their own).
# TRELLO_API_KEY=
# Where MCP tools call the REST API (default: this backend over loopback).
# KANEO_INTERNAL_API_URL=
# GitHub App for repository sync and issue import (separate from GitHub
# sign-in above). Webhook URL: <KANEO_API_URL>/github-integration/webhook
# GITHUB_APP_ID=
# GITHUB_APP_NAME=
# GITHUB_WEBHOOK_SECRET=
# The app's private key as PEM text, or base64-encoded in the second variable.
# GITHUB_PRIVATE_KEY=
# GITHUB_PRIVATE_KEY_BASE64=

# --- Sent to the web app through GET /api/config --------------------------------
# SENTRY_WEB_DSN=
# SENTRY_ENVIRONMENT=
# Plausible analytics; both are needed to turn it on.
# PLAUSIBLE_DOMAIN=
# PLAUSIBLE_SCRIPT_URL=

# --- Kaneo Cloud only -------------------------------------------------------------
# KANEO_CLOUD=false
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_TEST_MODE=false
# CREEM_PRODUCT_PERSONAL_MONTHLY=
# CREEM_PRODUCT_PERSONAL_ANNUAL=
# CREEM_PRODUCT_TEAM_MONTHLY=
# CREEM_PRODUCT_TEAM_ANNUAL=
# BILLING_TRIAL_DAYS=14
# BILLING_FOUNDING_CUTOFF=
# BILLING_REMINDER_MAX_PER_RUN=
