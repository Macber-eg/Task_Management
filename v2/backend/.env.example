# Every setting lives here, in the backend. The frontend only needs the URL
# of this API. Values below match local development (`pnpm dev` here on 1338,
# the frontend's dev server on 5174); ../.env.example lists every variable.

# --- Core -------------------------------------------------------------------
PORT=1338
# Public URL of this API and of the web app (used for CORS, cookies, links).
KANEO_API_URL=http://localhost:1338
KANEO_CLIENT_URL=http://localhost:5174
# Comma-separated origins allowed to call the API. Defaults to KANEO_CLIENT_URL.
# CORS_ORIGINS=http://localhost:5173
# At least 32 characters: openssl rand -hex 32
AUTH_SECRET=
# Reverse proxies allowed to report the client address (default loopback).
# TRUSTED_PROXIES=127.0.0.0/8,::1/128
# Access token lifetime in seconds (default 300).
# AUTH_ACCESS_TTL_SECONDS=300

# --- Database ---------------------------------------------------------------
# 127.0.0.1 rather than localhost: on machines where something else holds
# IPv6 localhost (::1:5432), "localhost" can reach the wrong server.
DATABASE_URL=postgresql://kaneo:password@127.0.0.1:5432/kaneo
# Or derive it from parts:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=kaneo
# POSTGRES_USER=kaneo
# POSTGRES_PASSWORD=

# --- Email (SMTP) -----------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- File storage (S3) ------------------------------------------------------
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_MAX_IMAGE_UPLOAD_BYTES=10485760

# --- Sent to the web app through GET /api/config -----------------------------
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# SENTRY_WEB_DSN=
# SENTRY_ENVIRONMENT=
# Plausible analytics; both are needed to turn it on.
# PLAUSIBLE_DOMAIN=
# PLAUSIBLE_SCRIPT_URL=
