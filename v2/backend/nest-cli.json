{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": {
        "extensions": [
          ".js",
          ".ts",
          ".tsx"
        ]
      }
    },
    "typeCheck": false,
    "deleteOutDir": true,
    "assets": [
      {
        "include": "**/*.sql",
        "watchAssets": true
      }
    ]
  }
}
