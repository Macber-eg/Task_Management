{
  "name": "task-management-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS + TypeORM backend for the task management app",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migration:run": "node dist/database/run-migrations.js",
    "openapi:export": "node dist/common/openapi/export-openapi.js"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/typeorm": "^12.0.3",
    "@octokit/webhooks": "14.2.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "^2.3.1",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "creem": "^1.14.0",
    "croner": "^10.0.1",
    "dotenv": "^18.0.3",
    "express": "^5.3.0",
    "file-type": "^22.3.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.6.0",
    "octokit": "5.0.5",
    "openid-client": "^6.9.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "typeorm": "^1.1.3",
    "undici": "^7.30.2",
    "ws": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.11.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "typescript": "~6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
